## credible bands
for (r in seq_len(nrow(runs(!is.na(med))))) {
ix <- runs(!is.na(med))[r, 1]:runs(!is.na(med))[r, 2]
polygon(c(grid[ix], rev(grid[ix])), c(lo95[ix], rev(hi95[ix])),
