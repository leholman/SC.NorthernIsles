lon_sat_m <- matrix(lon_sat, nx, ny)
lat_sat_m <- matrix(lat_sat, nx, ny, byrow = TRUE)
hit_sat <- nearest_wet(sat, lon_sat_m, lat_sat_m, lon0, lat0)
cat(sprintf("SAT cell: lon %.2f, lat %.2f  (%.0f km from target)\n",
lon_sat[hit_sat$ilon], lat_sat[hit_sat$ilat], hit_sat$dist))
data$sat    <- sat[hit_sat$ilon, hit_sat$ilat, ]
