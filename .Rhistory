library(ncdf4)
## ---- 1. target site ---------------------------------------------------------
lon0 <- 10.397342   # Kalo Vig
lat0 <- 56.249136
FILL <- 1e30        # anything this large is an unconverted _FillValue
## Turn whatever the file gives us into a lon x lat matrix matching x[,,1].
## Handles: 2D (either orientation) and 1D (along dim 1 or dim 2).
coord_grid <- function(v, x, what) {
n1 <- dim(x)[1]; n2 <- dim(x)[2]
g <- if (!is.null(dim(v)) && length(dim(v)) == 2) {
if (identical(dim(v), c(n1, n2))) v
else if (identical(dim(v), c(n2, n1))) t(v)
else stop(what, ": 2D coords ", paste(dim(v), collapse = "x"),
" do not match data ", n1, "x", n2)
} else if (length(v) == n1) {
matrix(v, n1, n2)                 # varies along dimension 1
} else if (length(v) == n2) {
matrix(v, n1, n2, byrow = TRUE)   # varies along dimension 2
} else {
stop(what, ": coord length ", length(v), " matches neither ", n1,
" nor ", n2)
}
g[!is.finite(g) | abs(g) > FILL] <- NA
g
}
## Great-circle distance (km) from one point to a grid of points.
## Longitude wrapping is handled by the sin(), so 0-360 and -180-180 both work.
gc_dist <- function(lon0, lat0, lon, lat) {
p <- pi / 180
a <- sin((lat - lat0) * p / 2)^2 +
cos(lat0 * p) * cos(lat * p) * sin((lon - lon0) * p / 2)^2
2 * 6371 * asin(pmin(sqrt(a), 1))
}
## Nearest cell with a complete time series.
##   x        : lon x lat x age array
##   lonm/latm: matrices matching x[,,1]
## Works entirely with flat vectors, so nothing depends on dim() attributes.
nearest_wet <- function(x, lonm, latm, lon0, lat0) {
n1 <- dim(x)[1]
ok  <- is.finite(x) & abs(x) < FILL
has <- as.vector(rowSums(ok, dims = 2) == dim(x)[3])   # complete series?
d <- as.vector(gc_dist(lon0, lat0, lonm, latm))
d[!has] <- NA                                          # drop land / masked
d[is.na(as.vector(lonm)) | is.na(as.vector(latm))] <- NA
i <- which.min(d)                                      # which.min skips NA
if (!length(i)) stop("no grid cell anywhere has a complete series")
hit <- list(i    = i,
ilon = ((i - 1L) %% n1) + 1L,
ilat = ((i - 1L) %/% n1) + 1L,
lon  = as.vector(lonm)[i],
lat  = as.vector(latm)[i],
dist = d[i],
d    = d)
## belt and braces: the cell we return must really have data
stopifnot(all(is.finite(x[hit$ilon, hit$ilat, ])))
hit
}
report <- function(hit, label) {
cat(sprintf("%s: cell [%d, %d]  lon %.2f, lat %.2f  (%.0f km from target)\n",
label, hit$ilon, hit$ilat, hit$lon, hit$lat, hit$dist))
}
## ---- 3. sea surface temperature ---------------------------------------------
nc      <- nc_open("rawdata/Climate/LGMR_SST_climo.nc")
sst     <- ncvar_get(nc, "sst")       # lon x lat x age (320 x 384 x 120)
sst_std <- ncvar_get(nc, "sst_std")
lon_sst <- ncvar_get(nc, "lon")
lat_sst <- ncvar_get(nc, "lat")
age     <- ncvar_get(nc, "age")       # years BP
nc_close(nc)
lon_sst_m <- coord_grid(lon_sst, sst, "SST lon")
lat_sst_m <- coord_grid(lat_sst, sst, "SST lat")
hit_sst <- nearest_wet(sst, lon_sst_m, lat_sst_m, lon0, lat0)
report(hit_sst, "SST")
## the 5 nearest wet cells, so you can see which sea basin you landed in
k <- order(hit_sst$d)[1:5]
print(data.frame(lon = round(as.vector(lon_sst_m)[k], 2),
lat = round(as.vector(lat_sst_m)[k], 2),
km  = round(hit_sst$d[k])))
data <- data.frame(age    = age,
sst    = sst[hit_sst$ilon, hit_sst$ilat, ],
sst_sd = sst_std[hit_sst$ilon, hit_sst$ilat, ])
## ---- 4. surface air temperature ---------------------------------------------
nc      <- nc_open("rawdata/Climate/LGMR_SAT_climo.nc")
sat     <- ncvar_get(nc, "sat")       # lon x lat x age (144 x 96 x 120)
sat_std <- ncvar_get(nc, "sat_std")
lon_sat <- ncvar_get(nc, "lon")
lat_sat <- ncvar_get(nc, "lat")
nc_close(nc)
lon_sat_m <- coord_grid(lon_sat, sat, "SAT lon")
lat_sat_m <- coord_grid(lat_sat, sat, "SAT lat")
hit_sat <- nearest_wet(sat, lon_sat_m, lat_sat_m, lon0, lat0)
report(hit_sat, "SAT")
data$sat    <- sat[hit_sat$ilon, hit_sat$ilat, ]
data$sat_sd <- sat_std[hit_sat$ilon, hit_sat$ilat, ]
## ---- 5. 2-sigma envelopes ---------------------------------------------------
data$sst_upr <- data$sst + 2 * data$sst_sd
data$sst_lwr <- data$sst - 2 * data$sst_sd
data$sat_upr <- data$sat + 2 * data$sat_sd
data$sat_lwr <- data$sat - 2 * data$sat_sd
print(head(data[, c("age", "sst", "sst_sd", "sat", "sat_sd")]))
