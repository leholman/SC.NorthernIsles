pdf("figures/EUK.ice.v1.trends.pdf", width = 9, height = 3.5)
par(mfrow = c(1, 3))
for (species in unique(euk.ice.sum.nreps.long$spp)) {
loopdat <- euk.ice.sum.nreps.long[euk.ice.sum.nreps.long$spp == species, ]
