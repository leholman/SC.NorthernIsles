library(ncdf4)
## ---- 1. target site ---------------------------------------------------------
lon0 <- 10.397342   # Kalo Vig
lat0 <- 56.249136
## Great-circle distance (km) from one point to a grid of points.
## Works whether the file stores longitude as 0-360 or -180-180: the sin() of
## the longitude difference wraps correctly on its own, so no ifelse() needed.
gc_dist <- function(lon0, lat0, lon, lat) {
p <- pi / 180
a <- sin((lat - lat0) * p / 2)^2 +
cos(lat0 * p) * cos(lat * p) * sin((lon - lon0) * p / 2)^2
2 * 6371 * asin(pmin(1, sqrt(a)))
}
## Nearest cell with a complete time series.
##   x        : lon x lat x age array
##   lon, lat : matrices with the same lon x lat shape as x[,,1]
## Returns the indices, the distance, and the full masked distance matrix.
nearest_wet <- function(x, lon, lat, lon0, lat0) {
ok       <- is.finite(x) & abs(x) < 1e30        # finite and not a fill value
n_age    <- dim(x)[3]
has_data <- rowSums(ok, dims = 2) == n_age      # lon x lat logical mask
d <- gc_dist(lon0, lat0, lon, lat)
d[!has_data] <- NA                              # land / masked cells removed
i <- which.min(d)                               # which.min skips NA
if (!length(i)) stop("no grid cell with data anywhere")
ij <- arrayInd(i, dim(d))
list(ilon = ij[1], ilat = ij[2], dist = d[i], d = d)
}
## ---- 3. sea surface temperature ---------------------------------------------
nc      <- nc_open("rawdata/Climate/LGMR_SST_climo.nc")
sst     <- ncvar_get(nc, "sst")       # lon x lat x age  (320 x 384 x 120)
sst_std <- ncvar_get(nc, "sst_std")
lon_sst <- ncvar_get(nc, "lon")       # 2D: tripolar ocean grid
lat_sst <- ncvar_get(nc, "lat")       # 2D
age     <- ncvar_get(nc, "age")       # years BP
nc_close(nc)
hit_sst <- nearest_wet(sst, lon_sst, lat_sst, lon0, lat0)
cat(sprintf("SST cell: lon %.2f, lat %.2f  (%.0f km from target)\n",
lon_sst[hit_sst$ilon, hit_sst$ilat],
lat_sst[hit_sst$ilon, hit_sst$ilat],
hit_sst$dist))
## sanity check: the 5 nearest wet cells, so you can see where you landed
k <- order(hit_sst$d)[1:5]
print(data.frame(lon = round(lon_sst[k], 2),
lat = round(lat_sst[k], 2),
km  = round(hit_sst$d[k])))
data <- data.frame(age    = age,
sst    = sst[hit_sst$ilon, hit_sst$ilat, ],
sst_sd = sst_std[hit_sst$ilon, hit_sst$ilat, ])
## ---- 4. surface air temperature ---------------------------------------------
nc      <- nc_open("rawdata/Climate/LGMR_SAT_climo.nc")
sat     <- ncvar_get(nc, "sat")       # lon x lat x age  (144 x 96 x 120)
sat_std <- ncvar_get(nc, "sat_std")
lon_sat <- ncvar_get(nc, "lon")       # 1D, regular grid
lat_sat <- ncvar_get(nc, "lat")       # 1D
nc_close(nc)
## expand the 1D axes into matrices so the same helper works
nx <- length(lon_sat); ny <- length(lat_sat)
lon_sat_m <- matrix(lon_sat, nx, ny)
lat_sat_m <- matrix(lat_sat, nx, ny, byrow = TRUE)
hit_sat <- nearest_wet(sat, lon_sat_m, lat_sat_m, lon0, lat0)
cat(sprintf("SAT cell: lon %.2f, lat %.2f  (%.0f km from target)\n",
lon_sat[hit_sat$ilon], lat_sat[hit_sat$ilat], hit_sat$dist))
data$sat    <- sat[hit_sat$ilon, hit_sat$ilat, ]
data$sat_sd <- sat_std[hit_sat$ilon, hit_sat$ilat, ]
## ---- 5. 2-sigma envelopes ---------------------------------------------------
data$sst_upr <- data$sst + 2 * data$sst_sd
data$sst_lwr <- data$sst - 2 * data$sst_sd
data$sat_upr <- data$sat + 2 * data$sat_sd
data$sat_lwr <- data$sat - 2 * data$sat_sd
## ---- 6. plot ----------------------------------------------------------------
band <- function(age, upr, lwr, col)
polygon(c(age, rev(age)), c(upr, rev(lwr)),
col = adjustcolor(col, alpha.f = 0.25), border = NA)
ylim <- range(data[, c("sst_lwr", "sst_upr", "sat_lwr", "sat_upr")], na.rm = TRUE)
plot(range(data$age), ylim, type = "n",
xlim = rev(range(data$age)),          # oldest left, present right
xlab = "Age (years BP)", ylab = "Temperature (\u00b0C)",
main = "LGMR reconstruction, Kal\u00f8 Vig")
band(data$age, data$sst_upr, data$sst_lwr, "dodgerblue")
band(data$age, data$sat_upr, data$sat_lwr, "red4")
lines(data$age, data$sst, col = "dodgerblue", lwd = 2)
lines(data$age, data$sat, col = "red4",       lwd = 2)
ylim <- range(data[, c("sst_lwr", "sst_upr", "sat_lwr", "sat_upr")], na.rm = TRUE)
ylim
range(data$age)
View(data)
